<html>

<head>
  <title>New Message</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="container">
    <header class="header">
      <h1>New message</h1>
      <a href="/" class="btn-compose">Discard</a>
    </header>

    <div class="form-content">
      <form method="POST" action="/new">
        
        <div class="form-group">
          <label for="author">From:</label>
          <input type="text" name="author" id="author" class="form-input" placeholder="Seu nome" required>
        </div>
        
        <div class="form-group">
          <label for="message">Message:</label>
          <textarea name="messageText" id="message" class="form-input textarea-input" placeholder="Escreva sua mensagem..." rows="6" required></textarea>
        </div>

        <button type="submit" class="btn-submit">Send</button>
        
      </form>
    </div>
  </div>
</body>

</html>